.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: .5px solid #e6e6e6;
  z-index: 30;
}

.tab-bar {
  height: 67px;
  display: flex;
  align-items: stretch;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  color: #111;
}

.tab-name {
  font-size: 16px;
  line-height: 23px;
}

.tab-icon-wrap {
  position: relative;
}

.tab-icon {
  width: 24px;
  height: 24px;
}

.sell-circle {
  position: absolute;
  top: -3px;
  left: 50%;
  transform: translateX(-50%);
  height: 60px;
  width: 60px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff500;
  font-size: 36px;
  line-height: 50px;
  color: #111;
}

.tab-badge {
  position: absolute;
  top: -5px;
  right: -11px;
  background: #ee6259;
  color: #fff;
  border-radius: 12px;
  font-size: 10px;
  padding: 1px 4px;
  min-width: 14px;
  text-align: center;
}
