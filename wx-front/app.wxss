page {
  background: #f5f5f5;
  color: #252525;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx
}

view,
text,
navigator,
image,
input,
textarea,
button {
  box-sizing: border-box
}

button {
  font-size: 28rpx;
  margin: 0
}

button::after {
  border: 0
}

button[disabled] {
  opacity: .5
}

image {
  display: block
}

.container,
.screen {
  min-height: 100vh
}

.screen {
  padding: 24rpx 26rpx 48rpx
}

.safe-bottom {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom))
}

.row {
  display: flex;
  align-items: center
}

.between {
  justify-content: space-between
}

.wrap {
  flex-wrap: wrap
}

.grow {
  flex: 1;
  min-width: 0
}

.gap {
  gap: 20rpx
}

.gap-sm {
  gap: 12rpx
}

.muted {
  color: #929292;
  font-size: 24rpx
}

.small {
  font-size: 24rpx
}

.title {
  font-size: 34rpx;
  font-weight: 700
}

.bold {
  font-weight: 600
}

.price {
  color: #ed5552;
  font-size: 34rpx;
  font-weight: 700
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 22rpx
}

.section-title {
  font-size: 32rpx;
  font-weight: 650;
  margin: 28rpx 0 20rpx
}

.yellow {
  background: #ffe36a
}

.hero {
  background: #ffe36a;
  padding: 28rpx 28rpx 36rpx
}

.hero .title {
  font-size: 42rpx
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 100rpx;
  padding: 20rpx 26rpx;
  gap: 16rpx
}

.search-box input {
  flex: 1;
  min-width: 0
}

.search-icon {
  font-size: 30rpx;
  color: #555
}

.tabs {
  display: flex;
  gap: 32rpx;
  white-space: nowrap;
  overflow-x: auto;
  padding: 24rpx 4rpx 18rpx
}

.tab {
  font-size: 28rpx;
  color: #898989;
  padding-bottom: 14rpx;
  flex-shrink: 0
}

.tab.active {
  color: #222;
  font-weight: 700;
  border-bottom: 7rpx solid #ffd94f
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #f3f3f3;
  flex-shrink: 0
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff1b7;
  color: #917317;
  font-weight: 700;
  font-size: 32rpx
}

.pill {
  display: inline-block;
  background: #fff7d5;
  color: #7d6222;
  border-radius: 10rpx;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  margin: 0 10rpx 8rpx 0
}

.pill.gray {
  background: #f3f3f3;
  color: #888
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  background: #ffe16b;
  color: #26241f;
  font-weight: 600;
  border-radius: 18rpx;
  padding: 0 32rpx
}

.btn.secondary {
  background: #f3f3f3;
  color: #555
}

.btn.outline {
  background: #fff;
  border: 1rpx solid #ddd
}

.btn.danger {
  background: #fff0ee;
  color: #dd5950
}

.btn.small {
  min-height: 64rpx;
  padding: 0 22rpx;
  font-size: 25rpx;
  border-radius: 14rpx
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 18rpx;
  z-index: 20;
  border-top: 1rpx solid #eee
}

.bottom-action {
  min-width: 86rpx;
  text-align: center;
  font-size: 22rpx;
  color: #777
}

.bottom-action.active {
  color: #cb9700
}

.bottom-action .symbol {
  display: block;
  font-size: 34rpx;
  line-height: 40rpx
}

.field {
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0
}

.field:last-child {
  border: 0
}

.label {
  font-weight: 600;
  margin-bottom: 18rpx
}

.input {
  width: 100%;
  min-height: 58rpx;
  font-size: 28rpx
}

.textarea {
  width: 100%;
  min-height: 210rpx;
  font-size: 28rpx;
  line-height: 1.7
}

.field-row {
  display: flex;
  align-items: center;
  gap: 20rpx
}

.field-row .label {
  margin: 0;
  min-width: 140rpx
}

.field-row input,
.field-row picker {
  flex: 1;
  text-align: right
}

.picker-value {
  padding: 8rpx 0;
  color: #555
}

.empty {
  text-align: center;
  padding: 100rpx 24rpx;
  color: #aaa;
  line-height: 2
}

.empty-icon {
  font-size: 74rpx;
  color: #d8d8d8;
  margin-bottom: 22rpx
}

.loading {
  text-align: center;
  padding: 32rpx;
  color: #999;
  font-size: 24rpx
}

.body-text {
  white-space: pre-wrap;
  line-height: 1.8;
  word-break: break-all
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx
}

.goods-card {
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden
}

.goods-cover {
  width: 100%;
  height: 320rpx;
  background: #ececec
}

.goods-copy {
  padding: 20rpx
}

.goods-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 27rpx;
  line-height: 1.5;
  min-height: 80rpx
}

.entry-title {
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.6;
  margin: 20rpx 0 10rpx
}

.entry-body {
  line-height: 1.65;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden
}

.entry-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9rpx;
  margin: 20rpx 0
}

.entry-image {
  width: 100%;
  height: 186rpx;
  border-radius: 14rpx;
  background: #f2f2f2
}

.entry-images.single {
  grid-template-columns: 1fr
}

.entry-images.single .entry-image {
  height: 380rpx
}

.entry-footer {
  display: flex;
  gap: 26rpx;
  margin-top: 22rpx;
  color: #999;
  font-size: 23rpx
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx
}

.image-cell {
  height: 190rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f4f4f4
}

.image-cell image {
  width: 100%;
  height: 100%
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx
}

.image-delete {
  position: absolute;
  right: 0;
  top: 0;
  background: rgba(0, 0, 0, .6);
  color: white;
  padding: 8rpx 16rpx;
  z-index: 1
}

.list-row {
  padding: 27rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f3f3f3
}

.list-row:last-child {
  border: 0
}

.chevron {
  color: #b8b8b8;
  font-size: 32rpx
}

.notice {
  padding: 22rpx;
  background: #fff7d6;
  border-radius: 16rpx;
  color: #9a7b33;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 22rpx
}

.comment {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f2f2
}

.comment-content {
  margin: 16rpx 0 12rpx 94rpx;
  line-height: 1.65
}

.reply {
  background: #f7f7f7;
  border-radius: 14rpx;
  margin: 14rpx 0 0 94rpx;
  padding: 20rpx;
  line-height: 1.7;
  font-size: 25rpx
}

.comment-name {
  font-weight: 600;
  font-size: 26rpx
}

.link {
  color: #a47c08
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 24rpx 0
}

.badge {
  background: #f15c54;
  color: white;
  border-radius: 40rpx;
  padding: 3rpx 12rpx;
  font-size: 21rpx
}

.status {
  color: #a88412;
  font-size: 25rpx
}

.scroll-x {
  white-space: nowrap;
  width: 100%
}

.top-space {
  margin-top: 24rpx
}

.full-image {
  width: 100%;
  margin: 20rpx 0;
  border-radius: 18rpx
}

.check-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 0
}

.money {
  font-size: 44rpx;
  font-weight: 700
}

.job-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5
}

.job-card {
  padding: 30rpx
}

.job-card .price {
  font-size: 30rpx
}

.content-head {
  display: flex;
  align-items: center;
  gap: 18rpx
}

.comment-input {
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 20rpx 24rpx;
  flex: 1;
  min-width: 0
}

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .4);
  z-index: 40;
  display: flex;
  align-items: flex-end
}

.sheet {
  width: 100%;
  background: #fff;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0
}

.sheet textarea {
  background: #f6f6f6;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 20rpx 0
}

.profile-stats {
  display: flex;
  justify-content: space-around;
  text-align: center;
  padding-top: 28rpx
}

.stat-number {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx
}

.muted-link {
  color: #888;
  font-size: 25rpx
}

.error-text {
  color: #d75650
}

.hidden {
  display: none
}
