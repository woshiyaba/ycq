<view class="screen safe-bottom">
  <view wx:if="{{error}}" class="empty" bindtap="load">{{error}} · 点击重试</view>
  <block wx:if="{{entry}}">
    <view class="notice" wx:if="{{entry.status!=='PUBLISHED'}}">这条信息已下架</view>
    <view class="card">
      <view class="content-head" bindtap="author">
        <image wx:if="{{entry.author.avatarUrl}}" class="avatar" src="{{entry.author.avatarUrl}}" />
        <view wx:else class="avatar avatar-fallback">圈</view>
        <view class="grow">
          <view class="bold">{{entry.author.nickName}}</view>
          <view class="muted">{{entry.region}} · {{entry.createdAt}}</view>
        </view>
        <text class="chevron">›</text>
      </view>
      <view class="entry-title">{{entry.title}}</view>
      <block wx:if="{{entry.kind==='RECRUITMENT'}}">
        <view class="price">{{entry.salaryLabel}}</view>
        <view class="top-space">
          <text class="pill">{{entry.job.workType==='PART_TIME'?'兼职':'全职'}}</text>
          <text class="pill">{{entry.job.industry}}</text>
          <text class="pill" wx:for="{{entry.job.benefits}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="divider"></view>
        <view class="list-row">
          <text class="muted">招聘单位</text>
          <text>{{entry.job.company}}</text>
        </view>
        <view class="list-row">
          <text class="muted">招聘人数</text>
          <text>{{entry.job.headcount}} 人</text>
        </view>
        <view class="list-row">
          <text class="muted">结薪方式</text>
          <text>
            {{entry.job.settlement==='MONTHLY'?'月结':entry.job.settlement==='WEEKLY'?'周结':entry.job.settlement==='DAILY'?'日结':'完工结算'}}
          </text>
        </view>
        <view class="section-title">工作内容</view>
      </block>
      <view class="body-text">{{entry.body}}</view>
      <block wx:for="{{entry.images}}" wx:key="*this">
        <image class="full-image" mode="widthFix" src="{{item}}" data-url="{{item}}" bindtap="preview" />
      </block>
      <block wx:if="{{entry.kind==='RECRUITMENT'}}">
        <view class="section-title">岗位要求</view>
        <view class="body-text">{{entry.job.requirements || '详情请联系招聘者'}}</view>
        <view class="section-title">工作地点</view>
        <view class="body-text">⌖ {{entry.region}} {{entry.job.address}}</view>
        <view class="section-title">联系方式</view>
        <view class="row between">
          <view>{{entry.job.contactName}}</view>
          <button class="btn small" bindtap="call">拨打电话</button>
        </view>
      </block>
    </view>
    <view class="card" wx:if="{{mine}}">
      <view class="row gap">
        <button class="btn small grow" bindtap="edit">编辑</button>
        <button class="btn small secondary grow" bindtap="status" disabled="{{busy}}">
          {{entry.status==='PUBLISHED'?'下架':'重新上架'}}
        </button>
        <button class="btn small danger grow" bindtap="remove">删除</button>
      </view>
    </view>
    <view class="card">
      <view class="row between">
        <view class="section-title">留言 {{entry.commentCount || 0}}</view>
        <text class="link" bindtap="openComment">写留言</text>
      </view>
      <view class="comment" wx:for="{{comments}}" wx:key="id">
        <view class="content-head">
          <image wx:if="{{item.author.avatarUrl}}" class="avatar" src="{{item.author.avatarUrl}}" />
          <view wx:else class="avatar avatar-fallback">圈</view>
          <view class="grow">
            <view class="comment-name">{{item.author.nickName}}
              <text class="muted" wx:if="{{item.replyUser}}">回复 {{item.replyUser.nickName}}</text>
            </view>
            <view class="muted">{{item.createdAt}}</view>
          </view>
          <text class="muted-link" wx:if="{{item.author.openId===me}}" bindtap="removeComment"
            data-id="{{item.id}}">删除</text>
        </view>
        <view class="comment-content" bindtap="openComment" data-comment="{{item}}">{{item.body}}
          <text class="muted">回复</text>
        </view>
      </view>
      <view class="empty" wx:if="{{!comments.length&&!commentLoading}}">还没有留言，来聊两句吧</view>
      <view class="loading" wx:if="{{commentsMore}}" bindtap="loadComments">{{commentLoading?'加载中…':'查看更多留言'}}
      </view>
    </view>
  </block>
</view>
<view class="bottom-bar" wx:if="{{entry}}">
  <view class="bottom-action {{entry.liked?'active':''}}" bindtap="toggle" data-type="like">
    <text class="symbol">{{entry.liked?'♥':'♡'}}</text>{{entry.likeCount || 0}}
  </view>
  <view class="bottom-action {{entry.favorited?'active':''}}" bindtap="toggle" data-type="favorite">
    <text class="symbol">{{entry.favorited?'★':'☆'}}</text>收藏
  </view>
  <view class="bottom-action" bindtap="openComment">
    <text class="symbol">◌</text>留言
  </view>
  <button wx:if="{{!mine}}" class="btn grow" bindtap="chat">聊一聊</button>
  <button wx:else class="btn grow" bindtap="edit">编辑发布</button>
</view>
<view class="overlay" wx:if="{{commentOpen}}" bindtap="closeComment">
  <view class="sheet" catchtap="noop">
    <view class="row between">
      <text class="bold">{{reply?'回复 '+reply.author.nickName:'发表留言'}}</text>
      <text bindtap="closeComment">×</text>
    </view>
    <textarea class="textarea" value="{{commentBody}}" bindinput="inputComment" maxlength="1000" focus
      placeholder="说点什么吧…" adjust-position />
    <button class="btn" bindtap="sendComment" loading="{{busy}}" disabled="{{busy||!commentBody}}">发送留言
    </button>
  </view>
</view>
