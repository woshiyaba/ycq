page {
  background: #fff
}

.home-header {
  padding: 18rpx 26rpx 0;
  background: #fff
}

.home-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  height: 68rpx;
  padding-left: 20rpx
}

.home-search input {
  flex: 1;
  min-width: 0;
  font-size: 24rpx
}

.home-search button {
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 12rpx;
  background: #252525;
  color: #fff;
  min-width: 124rpx;
  padding: 0 24rpx;
  font-size: 26rpx
}

.home-tabs {
  display: flex;
  justify-content: center;
  gap: 56rpx;
  padding: 28rpx 0 8rpx
}

.home-tab {
  color: #8d8d8d;
  font-size: 30rpx;
  padding: 0 0 12rpx
}

.home-tab.active {
  font-weight: 700;
  color: #222;
  border-bottom: 6rpx solid #ffdc50
}

.home-content {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom))
}

.home-categories {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 24rpx 16rpx;
  padding: 22rpx 24rpx 28rpx
}

.home-category {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  gap: 16rpx;
  white-space: nowrap
}

.category-icon {
  width: 48rpx;
  height: 48rpx
}

.home-banner {
  height: 150rpx;
  margin: 0 24rpx 22rpx;
  border-radius: 12rpx;
  overflow: hidden
}

.home-banner image {
  width: 100%;
  height: 150rpx
}

.goods-feed {
  background: #f7f7f7;
  padding: 14rpx 20rpx 24rpx
}

.goods-feed .grid {
  gap: 16rpx
}

.goods-feed .goods-card {
  border-radius: 14rpx
}

.goods-feed .goods-copy {
  padding: 16rpx
}

.goods-feed .goods-title {
  font-size: 25rpx;
  line-height: 1.5;
  min-height: 76rpx
}

.goods-feed .price {
  font-size: 32rpx
}

.community-feed {
  background: #f7f7f7;
  padding: 20rpx 24rpx
}
