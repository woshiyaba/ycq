<import src="../../templates/cards.wxml" />
<view class="safe-bottom">
  <view wx:if="{{error}}" class="empty" bindtap="load">{{error}} · 点击重试</view>
  <block wx:if="{{goods}}">
    <swiper class="goods-swiper" indicator-dots>
      <swiper-item wx:for="{{gallery}}" wx:key="id">
        <image src="{{item.imgUrl}}" mode="aspectFill" bindtap="preview" data-url="{{item.imgUrl}}" />
      </swiper-item>
    </swiper>
    <view class="screen">
      <view class="card">
        <view class="row between">
          <view class="price money">¥ {{goods.price}}</view>
          <text class="pill gray" wx:if="{{!goods.isSelling}}">已售出 / 已下架</text>
        </view>
        <view class="muted top-space" wx:if="{{goods.marketPrice}}">原价 ¥ {{goods.marketPrice}}</view>
        <view class="entry-title">{{goods.name}}</view>
        <view class="top-space">
          <text class="pill" wx:if="{{goods.ableSelfTake}}">支持自提</text>
          <text class="pill" wx:if="{{goods.ableMeet}}">同城面交</text>
          <text class="pill" wx:if="{{goods.ableExpress}}">{{goods.postage?'运费 ¥'+goods.postage:'包邮'}}</text>
        </view>
        <view class="body-text top-space">{{goods.desc}}</view>
        <view class="muted top-space">⌖ {{goods.region}} · {{goods.browseCount||0}} 人看过</view>
      </view>
      <view class="card content-head" bindtap="author">
        <image wx:if="{{seller.avatarUrl}}" class="avatar" src="{{seller.avatarUrl}}" />
        <view wx:else class="avatar avatar-fallback">圈</view>
        <view class="grow">
          <view class="bold">{{seller.nickName}}</view>
          <view class="muted">查看 TA 的主页</view>
        </view>
        <text class="chevron">›</text>
      </view>
      <view class="card" wx:if="{{mine}}">
        <view class="row gap">
          <button class="btn small grow" bindtap="edit">编辑宝贝</button>
          <button class="btn small secondary grow" bindtap="status" disabled="{{busy}}">
            {{goods.isSelling?'下架':'上架'}}
          </button>
          <button class="btn small danger" bindtap="remove">删除</button>
        </view>
      </view>
      <view class="card">
        <view class="row between">
          <view class="section-title">留言 {{comments.length}}</view>
          <text class="link" bindtap="comment">写留言</text>
        </view>
        <view class="comment" wx:for="{{comments}}" wx:key="id">
          <view class="content-head">
            <image wx:if="{{item.simpleUser.avatarUrl}}" class="avatar" src="{{item.simpleUser.avatarUrl}}" />
            <view wx:else class="avatar avatar-fallback">圈</view>
            <view class="grow">
              <view class="comment-name">{{item.simpleUser.nickName}}</view>
              <view class="muted">{{item.createTime}}</view>
            </view>
            <text wx:if="{{item.simpleUser.openId===me}}" class="muted-link" bindtap="removeComment"
              data-id="{{item.id}}">删除</text>
          </view>
          <view class="comment-content" bindtap="comment" data-comment="{{item}}">{{item.content}}
            <text class="muted">回复</text>
          </view>
          <view class="reply" wx:for="{{item.replyList}}" wx:for-item="replyItem" wx:key="id">
            <view bindtap="comment" data-comment="{{replyItem}}">
              <text class="bold">{{replyItem.simpleUser.nickName}}</text> 回复
              {{replyItem.replyUserName}}：{{replyItem.content}}
            </view>
            <text wx:if="{{replyItem.simpleUser.openId===me}}" class="muted-link" bindtap="removeComment"
              data-id="{{replyItem.id}}">删除</text>
          </view>
        </view>
        <view class="empty" wx:if="{{!comments.length}}">还没有留言，来聊两句吧</view>
      </view>
      <view class="section-title" wx:if="{{related.length}}">你可能还喜欢</view>
      <view class="grid">
        <block wx:for="{{related}}" wx:key="id">
          <template is="goods" data="{{item: item}}" />
        </block>
      </view>
    </view>
  </block>
</view>
<view class="bottom-bar" wx:if="{{goods}}">
  <view class="bottom-action {{collected?'active':''}}" bindtap="collect">
    <text class="symbol">{{collected?'★':'☆'}}</text>收藏
  </view>
  <view class="bottom-action" bindtap="comment">
    <text class="symbol">◌</text>留言
  </view>
  <button class="btn secondary grow" bindtap="chat" wx:if="{{!mine}}">聊一聊</button>
  <button class="btn grow" bindtap="buy" wx:if="{{!mine}}" disabled="{{!goods.isSelling}}">
    {{goods.isSelling?'立即购买':'暂不可购买'}}
  </button>
  <button class="btn grow" wx:else bindtap="edit">管理宝贝</button>
</view>
<view class="overlay" wx:if="{{commentOpen}}" bindtap="closeComment">
  <view class="sheet" catchtap="noop">
    <view class="row between">
      <view class="bold">{{reply?'回复 '+reply.simpleUser.nickName:'发表留言'}}</view>
      <text bindtap="closeComment">×</text>
    </view>
    <textarea class="textarea" value="{{commentBody}}" bindinput="input" maxlength="1000" focus
      placeholder="说点什么吧…" />
    <button class="btn" bindtap="sendComment" loading="{{busy}}" disabled="{{busy||!commentBody}}">发送留言
    </button>
  </view>
</view>
