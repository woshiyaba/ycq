<view class="profile-hero">
  <view class="row gap" bindtap="profile">
    <image wx:if="{{profile.avatarUrl}}" class="avatar avatar-lg" src="{{profile.avatarUrl}}" />
    <view wx:else class="avatar avatar-lg avatar-fallback">圈</view>
    <view class="grow">
      <view class="title">{{logged?profile.nickName:'登录运城圈'}}</view>
      <view class="small top-space">{{logged?'编辑个人资料 ›':'记录生活，发现身边的人和事'}}</view>
    </view>
    <text class="chevron">›</text>
  </view>
  <view class="profile-stats">
    <view bindtap="go" data-url="/pages/account/list/list?mode=favorites">
      <view class="stat-number">{{profile.favoriteCount||0}}</view>
      <view class="small">收藏</view>
    </view>
    <view bindtap="go" data-url="/pages/account/list/list?mode=history">
      <view class="stat-number">{{profile.historyCount||0}}</view>
      <view class="small">足迹</view>
    </view>
    <view bindtap="go" data-url="/pages/account/list/list?mode=following">
      <view class="stat-number">{{profile.followingCount||0}}</view>
      <view class="small">关注</view>
    </view>
  </view>
</view>
<view class="screen">
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view class="card">
    <view class="row between">
      <view class="section-title">我的交易</view>
      <text class="muted-link" bindtap="go" data-url="/pages/orders/list/list">全部订单 ›</text>
    </view>
    <view class="trade-grid">
      <view bindtap="go" data-url="/pages/account/list/list?mode=goods">
        <view class="trade-icon">▤</view>
        <view>我发布的</view>
        <view class="muted">{{profile.postedCount||0}}</view>
      </view>
      <view bindtap="go" data-url="/pages/orders/list/list?role=buyer">
        <view class="trade-icon">▣</view>
        <view>我买到的</view>
        <view class="muted">{{profile.boughtCount||0}}</view>
      </view>
      <view bindtap="go" data-url="/pages/orders/list/list?role=seller">
        <view class="trade-icon">↗</view>
        <view>我卖出的</view>
        <view class="muted">{{profile.soldCount||0}}</view>
      </view>
      <view bindtap="go" data-url="/pages/orders/list/list?status=COMPLETED&amp;review=1">
        <view class="trade-icon">☆</view>
        <view>待评价</view>
      </view>
    </view>
  </view>
  <view class="card">
    <view class="list-row" bindtap="go" data-url="/pages/content/list/list?mode=mine&amp;kind=COMMUNITY">
      <text>◌　我的帖子</text>
      <view class="row gap">
        <text class="muted">{{profile.postCount||0}}</text>
        <text class="chevron">›</text>
      </view>
    </view>
    <view class="list-row" bindtap="go" data-url="/pages/content/list/list?mode=mine&amp;kind=RECRUITMENT">
      <text>▧　我的招聘</text>
      <view class="row gap">
        <text class="muted">{{profile.jobCount||0}}</text>
        <text class="chevron">›</text>
      </view>
    </view>
    <view class="list-row" bindtap="go" data-url="/pages/account/addresses/addresses">
      <text>⌖　收货地址</text>
      <text class="chevron">›</text>
    </view>
    <view class="list-row" bindtap="go" data-url="/pages/account/profile/profile">
      <text>⚙　个人资料与设置</text>
      <text class="chevron">›</text>
    </view>
  </view>
  <view class="muted" style="text-align:center;padding:30rpx">运城圈 · 让生活更有温度</view>
</view>
