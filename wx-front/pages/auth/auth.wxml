<view class="login-screen">
  <view class="login-logo">圈</view>
  <view class="login-title">欢迎来到运城圈</view>
  <view class="muted">身边好物 · 同城生活 · 招聘兼职</view>
  <view class="login-copy">登录后，可以发布动态、收藏好物
    <br />和身边的人聊一聊
  </view>
  <button class="btn" open-type="getUserInfo" bindgetuserinfo="startLogin" loading="{{busy}}"
    disabled="{{busy}}">{{busy?'登录中…':'微信授权登录'}}</button>
  <view class="error-text top-space small" wx:if="{{error}}">{{error}}</view>
  <button class="btn secondary top-space" bindtap="back">先逛一逛</button>
</view>
