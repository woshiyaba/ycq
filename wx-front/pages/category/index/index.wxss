.catalog {
  display: flex;
  height: calc(100vh - 360rpx - env(safe-area-inset-bottom))
}

.category-nav {
  width: 190rpx;
  background: #f5f5f5
}

.category-nav-item {
  padding: 34rpx 16rpx;
  text-align: center;
  color: #888;
  font-size: 26rpx
}

.category-nav-item.selected {
  background: #fff;
  border-left: 8rpx solid #ffda53;
  color: #262626;
  font-weight: 650
}

.category-content {
  flex: 1;
  background: #fff;
  padding: 26rpx 20rpx
}

.category-intro {
  background: #fff8dc
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26rpx 12rpx
}

.category-item {
  text-align: center;
  font-size: 23rpx;
  line-height: 1.6
}

.category-item image {
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto 14rpx
}
