<view class="hero">
  <view class="title">精选好物</view>
  <view class="search-box top-space" bindtap="go" data-url="/pages/search/search">
    <text>⌕</text>
    <text class="muted">寻找你喜欢的闲置宝贝</text>
  </view>
</view>
<view class="catalog">
  <scroll-view class="category-nav" scroll-y>
    <view wx:for="{{categories}}" wx:key="id" class="category-nav-item {{current===item.id?'selected':''}}"
      bindtap="choose" data-id="{{item.id}}">{{item.name}}</view>
  </scroll-view>
  <scroll-view class="category-content" scroll-y>
    <view class="card category-intro">
      <view class="bold">好物不闲置</view>
      <view class="muted top-space">总有一件，刚好适合你</view>
    </view>
    <view class="category-grid">
      <view wx:for="{{subcategories}}" wx:key="id" class="category-item" bindtap="go"
        data-url="/pages/category/list/list?id={{item.id}}">
        <image src="{{item.iconUrl}}" mode="aspectFit" />
        <view>{{item.name}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!subcategories.length&&!loading}}">{{error||'暂无分类'}}</view>
  </scroll-view>
</view>
