<import src="../../../templates/cards.wxml" />
<view class="recruit-header">
  <view class="recruit-title">来运城圈，轻松找工作</view>
  <view class="recruit-search">
    <text class="search-icon">⌕</text>
    <input value="{{keyword}}" bindinput="input" bindconfirm="search" confirm-type="search"
      placeholder="搜索职位、公司" />
    <button bindtap="search">搜岗位</button>
  </view>
  <view class="recruit-tabs">
    <view class="recruit-tab {{tab==='all'?'active':''}}" data-tab="all" bindtap="switchTab">推荐</view>
    <view class="recruit-tab {{tab==='day'?'active':''}}" data-tab="day" bindtap="switchTab">周结日结</view>
    <view class="recruit-tab {{tab==='part'?'active':''}}" data-tab="part" bindtap="switchTab">高薪兼职</view>
    <view class="recruit-tab {{tab==='food'?'active':''}}" data-tab="food" bindtap="switchTab">餐厅服务</view>
  </view>
</view>
<view class="screen recruit-feed">
  <block wx:for="{{entries}}" wx:key="id">
    <template is="job" data="{{item:item}}" />
  </block>
  <view class="empty" wx:if="{{!entries.length&&!loading}}">暂时没有符合条件的职位</view>
  <view wx:if="{{error}}" class="empty" bindtap="load">{{error}} · 重试</view>
  <view class="loading" wx:if="{{loading}}">正在加载…</view>
  <view class="loading" wx:if="{{!hasMore&&entries.length}}">已经到底啦</view>
</view>
<button class="recruit-publish" bindtap="publish">＋ 发布招聘</button>
