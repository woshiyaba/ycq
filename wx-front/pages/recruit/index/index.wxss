page {
  background: #f5f5f5
}

.recruit-header {
  background: #ffe36a;
  padding: 22rpx 28rpx 0
}

.recruit-title {
  font-size: 40rpx;
  font-weight: 750;
  padding: 8rpx 0 28rpx
}

.recruit-search {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 14rpx;
  gap: 16rpx;
  height: 76rpx;
  padding-left: 20rpx
}

.recruit-search input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx
}

.recruit-search button {
  height: 76rpx;
  line-height: 76rpx;
  background: #222;
  color: #fff;
  border-radius: 14rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  min-width: 144rpx
}

.recruit-tabs {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 26rpx
}

.recruit-tab {
  white-space: nowrap;
  font-size: 26rpx;
  color: #7e722f;
  padding: 10rpx 0 19rpx
}

.recruit-tab.active {
  color: #26231b;
  font-weight: 700;
  border-bottom: 6rpx solid #26231b
}

.recruit-feed {
  padding: 24rpx 24rpx calc(150rpx + env(safe-area-inset-bottom))
}

.recruit-feed .job-card {
  border-radius: 18rpx;
  padding: 26rpx;
  margin-bottom: 20rpx
}

.recruit-feed .job-title {
  font-size: 31rpx
}

.recruit-feed .price {
  font-size: 28rpx;
  white-space: nowrap
}

.recruit-publish {
  position: fixed;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 38rpx;
  border-radius: 60rpx;
  background: #ffdc53;
  color: #252525;
  font-size: 27rpx;
  font-weight: 650;
  box-shadow: 0 6rpx 18rpx #00000014;
  z-index: 25
}
