<import src="../../templates/cards.wxml" />
<view class="hero">
  <view class="content-head">
    <image wx:if="{{profile.avatarUrl}}" class="avatar avatar-lg" src="{{profile.avatarUrl}}" />
    <view wx:else class="avatar avatar-lg avatar-fallback">圈</view>
    <view class="grow">
      <view class="title">{{profile.nickName||'运城圈用户'}}</view>
      <view class="small top-space">{{profile.region||'运城'}} · {{profile.followerCount||0}} 位粉丝</view>
    </view>
    <button wx:if="{{!mine}}" class="btn small outline" bindtap="follow" disabled="{{busy}}">
      {{profile.following?'已关注':'＋ 关注'}}
    </button>
    <button wx:else class="btn small outline" bindtap="edit">编辑资料</button>
  </view>
  <view class="body-text top-space small">{{profile.bio||'这个人有点酷，还没有写简介。'}}</view>
</view>
<view class="screen">
  <view class="tabs">
    <view class="tab {{kind==='GOODS'?'active':''}}" data-kind="GOODS" bindtap="switchKind">好物</view>
    <view class="tab {{kind==='COMMUNITY'?'active':''}}" data-kind="COMMUNITY" bindtap="switchKind">帖子</view>
    <view class="tab {{kind==='RECRUITMENT'?'active':''}}" data-kind="RECRUITMENT" bindtap="switchKind">招聘
    </view>
  </view>
  <view class="grid" wx:if="{{kind==='GOODS'}}">
    <block wx:for="{{items}}" wx:key="id">
      <template is="goods" data="{{item: item}}" />
    </block>
  </view>
  <block wx:else>
    <block wx:for="{{items}}" wx:key="id">
      <template is="{{kind==='RECRUITMENT'?'job':'entry'}}" data="{{item: item}}" />
    </block>
  </block>
  <view class="empty" wx:if="{{!items.length&&!loading}}">{{error||'TA 还没有发布相关内容'}}</view>
  <view class="loading" wx:if="{{loading}}">正在加载…</view>
</view>
