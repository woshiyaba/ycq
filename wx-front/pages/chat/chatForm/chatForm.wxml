<view class="chat-screen">
  <view class="chat-context" wx:if="{{goods||content}}">
    <view class="row gap">
      <image wx:if="{{goods.primaryPicUrl||content.primaryPicUrl}}" class="context-cover"
        src="{{goods.primaryPicUrl||content.primaryPicUrl}}" mode="aspectFill" bindtap="card" />
      <view class="grow" bindtap="card">
        <view class="bold context-title">{{goods.name||content.title}}</view>
        <view class="muted top-space">{{content?(content.kind==='RECRUITMENT'?'招聘咨询':'圈友动态'):'交易前聊一聊'}}</view>
        <view class="price" wx:if="{{goods}}">¥ {{goods.price}}</view>
      </view>
      <button class="btn small" wx:if="{{goods&&goods.sellerId!==me&&goods.isSelling}}" bindtap="buy">购买
      </button>
    </view>
  </view>
  <scroll-view class="conversation" scroll-y scroll-into-view="{{scrollTo}}" bindscrolltoupper="load">
    <view class="loading" wx:if="{{hasMore}}" bindtap="load">{{loading?'加载中…':'查看更早消息'}}</view>
    <view class="notice" wx:if="{{error}}">{{error}}</view>
    <view wx:for="{{history}}" wx:key="index" class="message-group">
      <view class="message-time">{{item.sendTime}}</view>
      <view class="message-row {{item.mine?'outgoing':''}}">
        <image wx:if="{{item.mine?avatar:otherSide.avatarUrl}}" class="avatar"
          src="{{item.mine?avatar:otherSide.avatarUrl}}" />
        <view wx:else class="avatar avatar-fallback">圈</view>
        <view class="bubble">{{item.messageBody}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!history.length&&!loading}}">打个招呼，开启一段对话吧</view>
    <view id="message-bottom" style="height:30rpx"></view>
  </scroll-view>
  <view class="message-composer">
    <input value="{{input}}" bindinput="input" bindconfirm="send" confirm-type="send" maxlength="2000"
      placeholder="说点什么…" adjust-position cursor-spacing="20" />
    <button class="btn small" bindtap="send" loading="{{sending}}" disabled="{{sending||!input||!otherSide.openId}}">发送</button>
  </view>
</view>
