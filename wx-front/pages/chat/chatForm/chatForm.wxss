.chat-screen {
  height: 100vh;
  display: flex;
  flex-direction: column
}

.chat-context {
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0
}

.context-cover {
  width: 118rpx;
  height: 118rpx;
  border-radius: 16rpx
}

.context-title {
  font-size: 26rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden
}

.conversation {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 20rpx 26rpx
}

.message-group {
  margin-bottom: 26rpx
}

.message-time {
  text-align: center;
  font-size: 21rpx;
  color: #aaa;
  margin: 15rpx 0 24rpx
}

.message-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start
}

.message-row.outgoing {
  flex-direction: row-reverse
}

.message-row .avatar {
  width: 68rpx;
  height: 68rpx
}

.bubble {
  max-width: 500rpx;
  background: #fff;
  border-radius: 0 20rpx 20rpx 20rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap
}

.outgoing .bubble {
  background: #ffe36a;
  border-radius: 20rpx 0 20rpx 20rpx
}

.message-composer {
  background: #fff;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  flex-shrink: 0
}

.message-composer input {
  background: #f5f5f5;
  border-radius: 18rpx;
  padding: 16rpx;
  flex: 1;
  height: 76rpx;
  min-width: 0
}
