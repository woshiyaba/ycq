<import src="../../templates/cards.wxml" />
<view class="screen">
  <view class="search-box">
    <text>⌕</text>
    <input focus value="{{keyword}}" bindinput="input" bindconfirm="search" confirm-type="search"
      placeholder="搜索好物、帖子和工作" />
    <text bindtap="search" class="bold">搜索</text>
  </view>
  <view class="tabs">
    <view class="tab {{kind==='GOODS'?'active':''}}" bindtap="switchKind" data-kind="GOODS">好物</view>
    <view class="tab {{kind==='COMMUNITY'?'active':''}}" bindtap="switchKind" data-kind="COMMUNITY">帖子</view>
    <view class="tab {{kind==='RECRUITMENT'?'active':''}}" bindtap="switchKind" data-kind="RECRUITMENT">招聘
    </view>
  </view>
  <block wx:if="{{!searched}}">
    <view class="card" wx:if="{{history.length}}">
      <view class="row between section-title">
        <text>最近搜索</text>
        <text class="muted-link" bindtap="clear">清空</text>
      </view>
      <text class="pill gray" wx:for="{{history}}" wx:key="*this" bindtap="choose" data-keyword="{{item}}">
        {{item}}
      </text>
    </view>
    <view class="card" wx:if="{{hot.length}}">
      <view class="section-title">大家都在搜</view>
      <text class="pill" wx:for="{{hot}}" wx:key="*this" bindtap="choose" data-keyword="{{item}}">{{item}}
      </text>
    </view>
  </block>
  <block wx:else>
    <view wx:if="{{kind==='GOODS'}}" class="grid">
      <block wx:for="{{items}}" wx:key="id">
        <template is="goods" data="{{item: item}}" />
      </block>
    </view>
    <block wx:else>
      <block wx:for="{{items}}" wx:key="id">
        <template is="{{kind==='RECRUITMENT'?'job':'entry'}}" data="{{item: item}}" />
      </block>
    </block>
    <view class="empty" wx:if="{{!items.length&&!loading}}">{{error||'没有找到相关内容，换个关键词试试'}}</view>
    <view class="loading" wx:if="{{loading}}">正在搜索…</view>
  </block>
</view>
